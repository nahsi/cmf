#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require

// d1 attention on Xe2's 8x16x16 matrix units in one pass over the keys: the
// `set` mask (window 0) or causal within a sliding window. A workgroup takes
// 16 queries of the 4 query heads sharing one KV head (64 stacked rows). K
// and V arrive as f16 rows padded past t with zeros (`d1_kv_half`), and the
// matrix units read them straight from memory.
//
// Softmax runs online with a lazy maximum: a row keeps its running max
// until a block beats it by more than 2^TAU, so P stays below 2^TAU and the
// accumulators, which KHR cooperative matrices cannot scale per row, are
// rescaled through shared memory only on those rare blocks. P is never
// normalized before the f16 cast; the division by the row sum happens in
// f32 on the way out, so long rows keep their precision.
//
// 512 lanes split the 64x128 output into tiles of at most four per subgroup
// at SIMD32 (two at SIMD16): ANV compiles this at SIMD32, where more live
// accumulators spill.
layout(local_size_x = 512) in;

layout(std430, set = 0, binding = 0) readonly buffer Q { vec4 q4[]; };
layout(std430, set = 0, binding = 1) readonly buffer K { float16_t k16[]; };
layout(std430, set = 0, binding = 2) readonly buffer V { float16_t v16[]; };
layout(std430, set = 0, binding = 3) buffer O { float o[]; };
layout(std430, set = 0, binding = 4) readonly buffer G { int grp[]; };
layout(std140, set = 0, binding = 5) uniform P {
    uint t;
    uint nh;
    uint nkv;
    uint state;
    uint r0;
    float scale;
    uint window;
    uint pad1;
} p;

const uint WG = 512;
const uint HD = 128;
const uint HPG = 4;
const uint QB = 16;
const uint ROWS = HPG * QB;
const uint BC = 32;
const uint NACC = 4;
const uint LPR = WG / ROWS;
const uint CPL = BC / LPR;
const uint OT = (ROWS / 8) * (HD / 16);
const uint ST = (ROWS / 8) * (BC / 16);
const float TAU = 8.0;
const float NEG = -3.0e38;

shared float16_t Qs[ROWS * HD];
shared float Ss[max(ROWS * BC, (WG / 16) * 128)];
shared float16_t Ps[ROWS * BC];
shared float rowm[ROWS];
shared float rowl[ROWS];
shared float rowa[ROWS];
shared int rowg[ROWS];
shared uint resc;

bool visible(uint i, int gi, uint j) {
    if (p.window != 0) {
        return j < p.t && j <= i && j + p.window > i;
    }
    return j < p.t && (i < p.state || j < p.state || grp[j] == gi);
}

void main() {
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint nsg = gl_NumSubgroups;
    const uint g = gl_WorkGroupID.y;
    const uint q0 = p.r0 + gl_WorkGroupID.x * QB;
    const float sl2 = p.scale * 1.4426950408889634;
    const uint kvs = p.nkv * HD;

    for (uint e = tid; e < ROWS * (HD / 4); e += WG) {
        const uint r = e / (HD / 4);
        const uint d4 = e % (HD / 4);
        const uint i = q0 + (r % QB);
        const uint h = g * HPG + r / QB;
        vec4 v = vec4(0.0);
        if (i < p.t) {
            v = q4[(i * p.nh + h) * (HD / 4) + d4];
        }
        const uint d = r * HD + d4 * 4;
        Qs[d] = float16_t(v.x);
        Qs[d + 1] = float16_t(v.y);
        Qs[d + 2] = float16_t(v.z);
        Qs[d + 3] = float16_t(v.w);
    }
    if (tid < ROWS) {
        rowg[tid] = grp[min(q0 + (tid % QB), p.t - 1)];
        rowm[tid] = NEG;
        rowl[tid] = 0.0;
    }
    uint klo = 0;
    uint khi = p.t;
    if (p.window != 0) {
        klo = ((q0 + 1 > p.window ? q0 + 1 - p.window : 0) / BC) * BC;
        khi = min(p.t, q0 + QB);
    }

    // Subgroup sg owns output tiles [sg*otps, (sg+1)*otps), row-band major,
    // so a P tile is loaded once per band, and score tile sg: 16 or 32
    // subgroups (SIMD32 or SIMD16) cover the 16 score tiles.
    const uint otps = OT / nsg;
    coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> acc[NACC];
    [[unroll]] for (uint i = 0; i < NACC; i++) {
        acc[i] = coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>(0.0);
    }

    const uint sr = tid / LPR;
    const uint sc0 = (tid % LPR) * CPL;
    const uint si = q0 + (sr % QB);
    barrier();

    for (uint kb = klo; kb < khi; kb += BC) {
        if (tid == 0) {
            resc = 0;
        }
        if (sg < ST) {
            coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> s =
                coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>(0.0);
            const uint ti = sg;
            const uint tn = ti % (BC / 16);
            [[unroll]] for (uint d0 = 0; d0 < HD; d0 += 16) {
                coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseA> a;
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b;
                coopMatLoad(a, Qs, (ti / (BC / 16)) * 8 * HD + d0, HD, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(b, k16, (kb + tn * 16) * kvs + g * HD + d0, kvs, gl_CooperativeMatrixLayoutColumnMajor);
                s = coopMatMulAdd(a, b, s);
            }
            coopMatStore(s, Ss, (ti / (BC / 16)) * 8 * BC + tn * 16, BC, gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();

        {
            const int gi = rowg[sr];
            float bm = NEG;
            [[unroll]] for (uint c = sc0; c < sc0 + CPL; c++) {
                const float s = visible(si, gi, kb + c) ? Ss[sr * BC + c] * sl2 : NEG;
                Ss[sr * BC + c] = s;
                bm = max(bm, s);
            }
            [[unroll]] for (uint m = 1; m < LPR; m <<= 1) {
                bm = max(bm, subgroupShuffleXor(bm, m));
            }
            const float mo = rowm[sr];
            float mn = mo;
            float alpha = 1.0;
            if (bm > mo + TAU) {
                mn = bm;
                alpha = exp2(mo - mn);
                if (mo > NEG) {
                    resc = 1;
                }
            }
            float ls = 0.0;
            [[unroll]] for (uint c = sc0; c < sc0 + CPL; c++) {
                const float s = Ss[sr * BC + c];
                const float pr = s > NEG ? exp2(s - mn) : 0.0;
                Ps[sr * BC + c] = float16_t(pr);
                ls += pr;
            }
            [[unroll]] for (uint m = 1; m < LPR; m <<= 1) {
                ls += subgroupShuffleXor(ls, m);
            }
            barrier();
            if (tid % LPR == 0) {
                rowm[sr] = mn;
                rowl[sr] = rowl[sr] * alpha + ls;
                rowa[sr] = alpha;
            }
        }
        barrier();

        if (resc != 0) {
            [[unroll]] for (uint i = 0; i < NACC; i++) {
                if (i < otps) {
                    coopMatStore(acc[i], Ss, sg * 128, 16, gl_CooperativeMatrixLayoutRowMajor);
                    subgroupBarrier();
                    for (uint e = gl_SubgroupInvocationID; e < 128; e += gl_SubgroupSize) {
                        Ss[sg * 128 + e] *= rowa[((sg * otps + i) / (HD / 16)) * 8 + e / 16];
                    }
                    subgroupBarrier();
                    coopMatLoad(acc[i], Ss, sg * 128, 16, gl_CooperativeMatrixLayoutRowMajor);
                    subgroupBarrier();
                }
            }
        }
        [[unroll]] for (uint k0 = 0; k0 < BC; k0 += 16) {
            coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseA> a;
            [[unroll]] for (uint i = 0; i < NACC; i++) {
                if (i < otps) {
                    const uint ti = sg * otps + i;
                    const uint tn = ti % (HD / 16);
                    if (i == 0 || tn == 0) {
                        coopMatLoad(a, Ps, (ti / (HD / 16)) * 8 * BC + k0, BC, gl_CooperativeMatrixLayoutRowMajor);
                    }
                    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b;
                    coopMatLoad(b, v16, (kb + k0) * kvs + g * HD + tn * 16, kvs, gl_CooperativeMatrixLayoutRowMajor);
                    acc[i] = coopMatMulAdd(a, b, acc[i]);
                }
            }
        }
        barrier();
    }

    [[unroll]] for (uint i = 0; i < NACC; i++) {
        if (i < otps) {
            const uint ti = sg * otps + i;
            const uint tn = ti % (HD / 16);
            const uint tm = ti / (HD / 16);
            coopMatStore(acc[i], Ss, sg * 128, 16, gl_CooperativeMatrixLayoutRowMajor);
            subgroupBarrier();
            for (uint e = gl_SubgroupInvocationID; e < 128; e += gl_SubgroupSize) {
                const uint rr = tm * 8 + e / 16;
                const uint qi = q0 + (rr % QB);
                const uint h = g * HPG + rr / QB;
                if (qi < p.t) {
                    o[(qi * p.nh + h) * HD + tn * 16 + (e % 16)] = Ss[sg * 128 + e] / rowl[rr];
                }
            }
            subgroupBarrier();
        }
    }
}
